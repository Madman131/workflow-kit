#!/usr/bin/env node
// Harness-agnostic commit tripwire. It enforces the current declaration; it never decides whether
// the declared tier is semantically correct. The retired `lane` route is REFUSED with an explicit
// `lane-retired` state, never a fall-through to "malformed".

import { execFileSync } from "node:child_process";
import { lstatSync, readFileSync, statSync } from "node:fs";
import path from "node:path";

// Git always reports repository paths with POSIX separators, including on Windows.
const DECLARATION = path.posix.join(".claude", "task-lane.json");
const SELF = path.posix.join(".githooks", "pre-commit");
const TASK_ID_RE = /^[a-z0-9][a-z0-9-]{2,79}$/;
// The hook deliberately knows only a small docs-only allowlist. Everything else — including
// unfamiliar extensions and basenames — is code-bearing, so an unknown future file cannot
// silently weaken enforcement.
const DOCS_EXTENSION_RE = /\.(?:md|mdx|rst|txt)$/i;
const DOCS_BASENAME_RE = /^(?:CHANGELOG|CODE_OF_CONDUCT|CONTRIBUTING|COPYING|LICENSE|NOTICE|README)$/i;
const EXEMPT_REASONS = new Set(["codex-down", "codex-quota", "trivial-edit"]);

// [P] KIT PARAMETERIZATION — since the `lane` route (and its risk-token deny-set) was retired, this
// hook reads NO family from .claude/kit.config.json: its gate — every non-docs staged path needs a
// current declaration — is config-independent. It still checks the file's STRUCTURAL integrity and
// FAILS CLOSED on a present-but-corrupt config (not valid JSON, not an object, symlinked, or
// unreadable): that file parameterizes the SIBLING controls (guard-lane-authoring, check-doc-size),
// and a code-bearing commit must not proceed while the shared control config is unreadable as a
// whole. HONEST LIMIT: this is WHOLE-FILE integrity only. A sibling's FIELD being malformed (say
// `executedPathDirs: "src"`) is caught by that sibling — the write guard denies, `doc:size` exits 1 —
// but not here; adding per-field checks would mean re-reading families this hook does not use. A
// legacy `laneRiskTokens` entry left by a pre-v1.5 adopt is IGNORED whatever its shape — a field no
// control reads cannot make a control fail open.
const KIT_CONFIG = path.posix.join(".claude", "kit.config.json");

// Absent config ⇒ fine (defaults-only is legitimate). Present-but-corrupt ⇒ { ok:false } ⇒ the main
// flow fails closed.
function loadKitConfig() {
  let st;
  try { st = lstatSync(KIT_CONFIG); }
  catch (e) {
    // Only ENOENT (truly absent) ⇒ ok. A permission/IO error means the config exists but is
    // unreadable ⇒ FAIL CLOSED (the sibling controls cannot read their families either).
    if (e && e.code === "ENOENT") return { ok: true };
    return { ok: false };
  }
  // A SYMLINKED/non-regular config is FAIL-CLOSED, not treated as absent (a dangling symlink would
  // otherwise read as "absent ⇒ fine" while the sibling controls fail closed on it). Matches
  // readDeclaration's symlink handling.
  if (st.isSymbolicLink() || !st.isFile()) return { ok: false };
  let parsed;
  try { parsed = JSON.parse(readFileSync(KIT_CONFIG, "utf8")); } catch { return { ok: false }; }
  if (!isPlainObject(parsed)) return { ok: false };
  return { ok: true };
}

function fail(reason, remediation = `Remediate by writing a fresh ${DECLARATION} as one of the two DOCUMENTED routes: mode \"in-thread\" with sessionId, taskId, and tier; or mode \"exempt\" with sessionId, taskId, a documented reason, and a tier. Rules: core/MULTI_AGENT.md, Task-lane declaration. For hook installation run: git config core.hooksPath .githooks`) {
  process.stderr.write(
    `pre-commit BLOCKED: ${reason}\n` +
    `${remediation}\n`,
  );
  process.exit(1);
}

function git(args) {
  return execFileSync("git", args, { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] });
}

function isPlainObject(value) {
  return value !== null && typeof value === "object" && Object.getPrototypeOf(value) === Object.prototype;
}

function stagedPaths() {
  // --no-renames expands a rename into its delete/add endpoints, so scope cannot hide either path.
  const raw = git(["diff", "--cached", "--name-only", "-z", "--no-renames"]);
  return raw.split("\0").filter(Boolean);
}

function isCodeBearing(rel) {
  return !DOCS_EXTENSION_RE.test(rel) &&
    !DOCS_BASENAME_RE.test(path.posix.basename(rel));
}

function headHasHook() {
  try {
    git(["cat-file", "-e", `HEAD:${SELF}`]);
    return true;
  } catch {
    return false;
  }
}

function readDeclaration() {
  let stat;
  let raw;
  try {
    const file = lstatSync(DECLARATION);
    if (!file.isFile() || file.isSymbolicLink()) return { state: "malformed" };
    stat = statSync(DECLARATION);
    raw = readFileSync(DECLARATION, "utf8");
  } catch {
    return { state: "undeclared" };
  }

  let declaration;
  try {
    declaration = JSON.parse(raw);
  } catch {
    return { state: "malformed" };
  }
  if (!isPlainObject(declaration)) return { state: "malformed" };

  const maxAgeHours = declaration.maxAgeHours === undefined ? 24 : declaration.maxAgeHours;
  if (typeof maxAgeHours !== "number" || !Number.isFinite(maxAgeHours) || maxAgeHours <= 0 || maxAgeHours > 168) {
    return { state: "malformed" };
  }
  const ageMs = Date.now() - stat.mtimeMs;
  if (ageMs < 0 || ageMs > maxAgeHours * 3600_000) return { state: "stale" };

  if (typeof declaration.sessionId !== "string" || !declaration.sessionId ||
    typeof declaration.taskId !== "string" || !TASK_ID_RE.test(declaration.taskId)) {
    return { state: "malformed" };
  }

  if (declaration.mode === "in-thread") {
    if (!["T0", "T1", "T2", "T3"].includes(declaration.tier)) return { state: "malformed" };
    // In-thread is the established tier-only route. Git can validate this declaration's
    // presence/freshness, but it must not invent a path scope the route does not carry.
    return { state: "in-thread", taskId: declaration.taskId };
  }
  // RETIRED with the cost-inversion build lane (doctrine at kit v1.4.0, mechanism at v1.5.0). An
  // explicit state, not a silent fall-through to "malformed", so the block names the real cause.
  if (declaration.mode === "lane") return { state: "lane-retired" };
  // Since v1.5.0 an exemption declares a tier exactly as `in-thread` does: the reason names the
  // unavailable SEAT, which says nothing about how risky the work is. A pre-v1.5 tier-less exemption
  // is NOT grandfathered — it gets its own explicit state so the block can name the offending field.
  // That ONE state covers BOTH polarities (absent, and present-but-invalid), so the block text must
  // say so: asserting "missing" against a file carrying `tier:"T9"` is a control lying about input it
  // just read.
  if (declaration.mode === "exempt") {
    if (!EXEMPT_REASONS.has(declaration.reason)) return { state: "malformed" };
    if (!["T0", "T1", "T2", "T3"].includes(declaration.tier)) return { state: "exempt-tier-missing" };
    return { state: "exempt", taskId: declaration.taskId };
  }
  return { state: "malformed" };
}

let paths;
try {
  paths = stagedPaths();
} catch {
  fail("the staged set could not be read");
}

if (paths.length === 0 || paths.every((rel) => !isCodeBearing(rel))) process.exit(0);
// The commit is code-bearing.
const kitConfig = loadKitConfig();
const bootstrap = !headHasHook();
if (bootstrap) {
  if (!paths.includes(SELF)) {
    fail(`tracked ${SELF} is absent from HEAD but is not staged for bootstrap`,
      `Remediate by staging ${SELF} for its one-time bootstrap, or use a branch that already contains it.`);
  }
  // The hook-only introduction may commit without a declaration. Any co-staged code path
  // still falls through to the normal current-declaration check below.
  if (paths.length === 1) process.exit(0);
}

// FAIL CLOSED on a corrupt config: a code-bearing commit cannot proceed while the shared control
// config is structurally unreadable — the sibling controls' families live in it, and a corrupt file
// must be loud at the every-lane floor, not just in the Claude lane. Docs-only commits already
// exited above; a pure hook-bootstrap commit exited above too, so this only blocks real code commits.
if (!kitConfig.ok) {
  fail(`${KIT_CONFIG} is present but MALFORMED (not valid JSON, not a plain object, symlinked, or unreadable)`,
    `Remediate by fixing ${KIT_CONFIG} to a plain JSON object, deleting it to fall back to the kit's portable defaults, or re-running: node bin/init.mjs`);
}

const declaration = readDeclaration();
if (declaration.state === "lane-retired") {
  fail(`${DECLARATION} declares the retired \`lane\` route`,
    "The `lane` route was RETIRED with the cost-inversion build lane (doctrine at kit v1.4.0, mechanism at v1.5.0) — it is not an available route. "
    + "Declare `in-thread` with the tier. Rules: core/MULTI_AGENT.md, Task-lane declaration.");
}
if (declaration.state === "exempt-tier-missing") {
  fail(`${DECLARATION} declares mode "exempt" without a valid tier`,
    'Set "tier": "T0"|"T1"|"T2"|"T3" (the field is MISSING OR INVALID) — since kit v1.5.0 an exemption declares one '
    + 'exactly as "in-thread" does: the reason names the unavailable SEAT, which says nothing about how risky the work '
    + 'is. A pre-v1.5 tier-less exemption is not grandfathered. Rules: core/MULTI_AGENT.md, Task-lane declaration.');
}
if (!["in-thread", "exempt"].includes(declaration.state)) fail(`${DECLARATION} is ${declaration.state}`);
