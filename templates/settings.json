{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-cross-repo-writes.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking write stays inside this repo…"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-lane-authoring.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking the task's lane declaration…"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-brief-rung.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking the pre-send verification rung for this brief…"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/sensor-sweep-owed.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking whether this edit owes a pre-fold dependency sweep…"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/sensor-mutation-owed.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking whether this edit owes a two-sided mutation record…"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-gate-ladder.mjs\"",
            "timeout": 10,
            "statusMessage": "Resolving the declared tier; surfacing the ladder it owes…"
          }
        ]
      },
      {
        "matcher": ".*send_message",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-brief-rung.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking the pre-send verification rung for this dispatch…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-owner-comms.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking the final message against OWNER_COMMS rule 1…"
          }
        ]
      }
    ]
  }
}
