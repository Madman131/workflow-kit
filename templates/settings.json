{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-cross-repo-writes.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking write stays inside this repo\u2026"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-lane-authoring.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking the task's lane declaration\u2026"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-brief-rung.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking the pre-send verification rung for this brief\u2026"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/sensor-sweep-owed.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking whether this edit owes a pre-fold dependency sweep\u2026"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/sensor-mutation-owed.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking whether this edit owes a two-sided mutation record\u2026"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/sensor-context-pressure.mjs\"",
            "timeout": 10,
            "statusMessage": "Reading this session's context size; the digest is owed past the threshold\u2026"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-gate-ladder.mjs\"",
            "timeout": 10,
            "statusMessage": "Resolving the declared tier; surfacing the ladder it owes\u2026"
          }
        ]
      },
      {
        "matcher": ".*send_message",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-brief-rung.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking the pre-send verification rung for this dispatch\u2026"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-owner-comms.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking the final message against OWNER_COMMS rule 1\u2026"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/sensor-token-ledger.mjs\"",
            "timeout": 10,
            "statusMessage": "Recording this turn's token usage in .claude/metrics/tokens.jsonl\u2026"
          }
        ]
      }
    ]
  }
}
